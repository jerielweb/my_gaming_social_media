---
import Button from "../components/button.astro";
import Layout from "../layouts/Layout.astro";
import profile from "../assets/profile.jpg";
import { WhatsappButtons } from "../data/whatsapp.ts";
import { Games } from "../data/data.ts";
import { Image } from "astro:assets";
---

<Layout title="Oboe Games">
  <main
    class="flex items-center justify-center flex-col container mx-auto h-screen w-8xl"
  >
    <header class="flex w-full items-center justify-center flex-col h-fit"
    transition:name="hero"
    >
      <div class="flex items-center justify-center w-fit border">
        <div
          id="hero"
          class="flex flex-col items-center justify-center md:w-184.5"
        >
          <div
            id="perfil"
            class="grid md:grid-cols-2 overflow-hidden w-full h-90 place-content-center place-items-center p-2 bg-[#333] gap-5"
          >
            <div class="flex h-full">
              <Image
                src={profile}
                alt="Perfil de Oboe Games"
                class="size-60 aspect-square"
              />
            </div>
            <div>
              <div class="grid font-minecraft md:gap-5 gap-[5.5px] grid-cols-4 md:grid-cols-2 lg:grid-cols-2 place-content-center place-items-center">
              {Games.map((game) => (
              <div class="border hover:border-[#666] active:border-black size-fit">
                <a id="button" href={game.url} class="size-20 border" title={game.name} target="_blank">
                  <img
                      src={game.src}
                      alt={game.name}
                      class="size-15 aspect-square"
                    />
                </a>
              </div>
              ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <footer class="flex items-center justify-center w-full" transition:animate="none" transition:name="buttons">
      <div
        id="links"
        class="grid mt-4 font-minecraft md:gap-4 gap-1 grid-cols-1"
      >
        {
          WhatsappButtons.map((button) => (
            <Button
              text={button.name}
              href={button.url}
              style=" lg:h-10 md:w-184.5 w-90 h-10"
              target={button.target}
            />
          ))
        }
      </div>
    </footer>
  </main>
</Layout>